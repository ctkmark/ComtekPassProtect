<span class="comtek-product-lockup" aria-label="Comtek PassProtect">
  <%= image_tag "/comtek-passprotect-icon.svg", alt: "", class: "comtek-product-icon", width: mark_size, height: mark_size, "aria-hidden": "true" %>

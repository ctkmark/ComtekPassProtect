<footer class="footer mt-auto py-3 border-top">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <div class="d-flex align-items-center gap-2">
        <%= link_to root_path(locale: locale.to_s), class: "text-decoration-none", "aria-label": "Comtek PassProtect home" do %>
          <%= render partial: "shared/brand_logo", locals: {height: 28} %>
        <% end %>
        <span class="small comtek-supporting-text">
          &copy; <%= Time.current.year %> Comtek System Solutions
        </span>
      </div>
      <span class="small comtek-supporting-text">
        Built using
        <%= link_to "Password Pusher", "https://github.com/pglombardo/PasswordPusher", target: "_blank", rel: "noopener noreferrer", class: "text-decoration-none" %>,
        Apache 2.0 licensed software by Apnotic.
      </span>
    </div>
    <% if Settings.brand.disclaimer.present? %>
      <p class="small comtek-supporting-text text-center mt-3 mb-0"><%= Settings.brand.disclaimer %></p>
    <% end %>
  </div>
</footer>

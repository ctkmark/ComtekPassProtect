<% if Settings.show_gdpr_consent_banner %>
  <div class="fixed-bottom text-center p-2 border-top" style="background: #F7F7FB; color: #17213A;"
      data-controller="gdpr"
      data-gdpr-target="cookieBanner"
      style="display: none;">
    <%= _('Browser cookies help make this tool work. By using it, you agree the use of these cookies.') %>

    <button class="btn btn-small btn-primary m-2" data-action="click->gdpr#acceptCookies">OK</button>
  </div>
<% end %>

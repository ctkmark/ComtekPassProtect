<% title('About Comtek PassProtect') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
      <header class="text-center mb-5">
        <div class="mb-3"><%= render partial: "shared/brand_logo", locals: {height: 56} %></div>
        <h1 class="h2 fw-semibold mb-2">About Comtek PassProtect</h1>
        <p class="lead comtek-supporting-text">Secure password protection for Comtek</p>
      </header>

      <section class="card shadow-sm mb-4">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold"><em class="bi bi-shield-lock me-2 text-primary"></em>Secure link sharing</h2>
          <p>Comtek PassProtect lets authorised staff create secure, time-limited links for sharing passwords and other sensitive text.</p>
          <p class="mb-0">Recipients can open their links without signing in. A link stops working when its configured viewing or expiry limit is reached.</p>
        </div>
      </section>

      <section class="card shadow-sm mb-4">
        <div class="card-body p-4">
          <h2 class="h5 fw-semibold"><em class="bi bi-people me-2 text-primary"></em>Access and protection</h2>
          <p>Creating new secret links requires a Comtek PassProtect account. Public registration is disabled.</p>
          <p class="mb-0">Treat every generated link as sensitive: anyone who has a valid link may retrieve its contents before it expires, subject to any additional passphrase protection you choose.</p>
        </div>
      </section>

      <section class="mb-4">
        <h2 class="h5 fw-semibold">Open-source acknowledgements</h2>
        <p>Comtek PassProtect is Comtek System Solutions' branded self-hosted deployment of the Apache 2.0-licensed
          <%= link_to "Password Pusher", "https://github.com/pglombardo/PasswordPusher", target: "_blank", rel: "noopener noreferrer" %>
          project by Peter Giacomo Lombardo and Apnotic. The upstream licence and applicable notices are preserved.
        </p>
        <p class="small comtek-supporting-text">The upstream project and its documentation describe the underlying open-source software, rather than Comtek-specific support arrangements.</p>
      </section>

      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Return to Comtek PassProtect", root_path, class: "btn btn-primary" %>
        <%= link_to "View source repository", "https://github.com/ctkmark/ComtekPassProtect", class: "btn btn-outline-secondary", target: "_blank", rel: "noopener noreferrer" %>
      </div>
    </div>
  </div>
</div>

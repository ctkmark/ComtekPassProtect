<% title("Sign in") %>
<h1 class="comtek-auth-heading text-center">Sign in to Comtek PassProtect</h1>
<p class="comtek-auth-subtitle text-center">Secure password protection for Comtek</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), data: {turbo: false}) do |f| %>
  <div class="form-floating mb-3">
    <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email", placeholder: "name@example.com", required: true %>
    <%= f.label :email, _("Email"), for: "user_email" %>
  </div>

  <div class="form-floating mb-3">
    <%= f.password_field :password, class: "form-control", autocomplete: "current-password", placeholder: "Password", required: true %>
    <%= f.label :password, _("Password"), for: "user_password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-check mb-3 text-start">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, I18n.t("devise.general.remember_me"), class: "form-check-label" %>
    </div>
  <% end %>

  <button class="w-100 btn btn-lg btn-primary" type="submit">Sign in with email</button>
<% end %>

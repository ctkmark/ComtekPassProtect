<% title("First run setup") %>

<section class="comtek-setup-card" aria-labelledby="setup-title">
  <h1 id="setup-title" class="mb-2">Set up Comtek PassProtect</h1>
  <p class="comtek-supporting-text mb-4">Create the first administrator account for secure password sharing.</p>

  <% if FirstRunBootCode.needed? %>
    <div class="comtek-setup-note mb-4" role="status">
      <strong>Boot code required.</strong>
      Retrieve the one-time code from the PassProtect container logs using SSH. The code is not emailed and must not be shared.
    </div>
  <% end %>

  <%= form_with(model: resource, as: resource_name, url: first_run_path) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <% if FirstRunBootCode.needed? %>
      <div class="form-floating mb-3">
        <%= f.text_field :boot_code, class: "form-control", placeholder: "Boot code", required: true, autocomplete: "off", autofocus: true %>
        <%= f.label :boot_code, "Boot code" %>
      </div>
    <% end %>

    <div class="form-floating mb-3">
      <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", required: true, autocomplete: "email" %>
      <%= f.label :email, "Administrator email" %>
    </div>

    <div class="form-floating mb-3">
      <%= f.password_field :password, class: "form-control", placeholder: "Password", required: true, autocomplete: "new-password" %>
      <%= f.label :password, "Password" %>
    </div>

    <% minimum_password_length = @minimum_password_length || (resource_class.password_length.min if respond_to?(:resource_class) && resource_class.respond_to?(:password_length)) %>
    <% if minimum_password_length %>
      <p class="comtek-supporting-text small mb-3">Use a unique password of at least <%= minimum_password_length %> characters.</p>
    <% end %>

    <button class="w-100 btn btn-lg btn-primary" type="submit">Create administrator account</button>
  <% end %>
</section>

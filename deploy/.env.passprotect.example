# Copy to deploy/.env.passprotect, chmod 600. Never commit the real values.
# Use 'openssl rand -hex 64' for SECRET_KEY_BASE and 'openssl rand -hex 32' for MASTER_KEY.
# Keep these keys safely backed up: losing or rotating the master key may make secrets unreadable.
PASS_PROTECT_SECRET_KEY_BASE=
PASS_PROTECT_MASTER_KEY=
